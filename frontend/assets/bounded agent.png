<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 720" width="100%" height="100%">
  <defs>
    <!-- Background Gradient -->
    <linearGradient id="canvasBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0B0F19"/>
      <stop offset="50%" stop-color="#111827"/>
      <stop offset="100%" stop-color="#070A10"/>
    </linearGradient>

    <!-- Shield Glow & Gradients -->
    <linearGradient id="shieldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3B82F6"/>
      <stop offset="50%" stop-color="#1D4ED8"/>
      <stop offset="100%" stop-color="#0F172A"/>
    </linearGradient>

    <linearGradient id="neonBlue" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#60A5FA"/>
      <stop offset="100%" stop-color="#3B82F6"/>
    </linearGradient>

    <linearGradient id="accentGreen" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#34D399"/>
      <stop offset="100%" stop-color="#059669"/>
    </linearGradient>

    <filter id="glowEffect" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="16" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>

    <filter id="cardShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#000000" flood-opacity="0.4"/>
    </filter>
  </defs>

  <!-- Background Canvas -->
  <rect width="1280" height="720" fill="url(#canvasBg)"/>

  <!-- Subtle Blueprint Grid Lines -->
  <g stroke="#1E293B" stroke-width="1" stroke-opacity="0.4">
    <line x1="80" y1="0" x2="80" y2="720"/>
    <line x1="240" y1="0" x2="240" y2="720"/>
    <line x1="400" y1="0" x2="400" y2="720"/>
    <line x1="560" y1="0" x2="560" y2="720"/>
    <line x1="720" y1="0" x2="720" y2="720"/>
    <line x1="880" y1="0" x2="880" y2="720"/>
    <line x1="1040" y1="0" x2="1040" y2="720"/>
    <line x1="1200" y1="0" x2="1200" y2="720"/>
    
    <line x1="0" y1="90" x2="1280" y2="90"/>
    <line x1="0" y1="180" x2="1280" y2="180"/>
    <line x1="0" y1="270" x2="1280" y2="270"/>
    <line x1="0" y1="360" x2="1280" y2="360"/>
    <line x1="0" y1="450" x2="1280" y2="450"/>
    <line x1="0" y1="540" x2="1280" y2="540"/>
    <line x1="0" y1="630" x2="1280" y2="630"/>
  </g>

  <!-- Header Badge: Track -->
  <g transform="translate(100, 110)">
    <rect width="420" height="36" rx="18" fill="#1E293B" stroke="#3B82F6" stroke-width="1.2"/>
    <circle cx="20" cy="18" r="5" fill="#60A5FA"/>
    <text x="36" y="23" font-family="Inter, -apple-system, sans-serif" font-size="13" font-weight="600" fill="#93C5FD" letter-spacing="1">
      TRACK 01: AI GROWTH &amp; AGENTIC COMMERCE
    </text>
  </g>

  <!-- Main Hero Title & Tagline -->
  <text x="100" y="215" font-family="Inter, -apple-system, sans-serif" font-size="46" font-weight="800" fill="#F8FAFC" letter-spacing="-0.5">
    Bounded Agent Checkout
  </text>
  
  <text x="100" y="265" font-family="Inter, -apple-system, sans-serif" font-size="22" font-weight="500" fill="#94A3B8">
    A permission boundary for AI-initiated commerce.
  </text>

  <!-- Left: Bullet Architecture Badges -->
  <g transform="translate(100, 320)">
    <!-- Policy Gate Pill -->
    <g transform="translate(0, 0)">
      <rect width="260" height="54" rx="10" fill="#111827" stroke="#1E293B" stroke-width="1.5"/>
      <rect x="14" y="15" width="24" height="24" rx="6" fill="#065F46"/>
      <text x="26" y="31" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" font-weight="700" fill="#34D399">✓</text>
      <text x="48" y="27" font-family="Inter, sans-serif" font-size="13" font-weight="700" fill="#F8FAFC">Deterministic Mandate</text>
      <text x="48" y="43" font-family="Inter, sans-serif" font-size="11" font-weight="500" fill="#64748B">Spending cap &amp; category lock</text>
    </g>

    <!-- Sandbox Pill -->
    <g transform="translate(280, 0)">
      <rect width="260" height="54" rx="10" fill="#111827" stroke="#1E293B" stroke-width="1.5"/>
      <rect x="14" y="15" width="24" height="24" rx="6" fill="#1E3A8A"/>
      <text x="26" y="31" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" font-weight="700" fill="#60A5FA">🛡</text>
      <text x="48" y="27" font-family="Inter, sans-serif" font-size="13" font-weight="700" fill="#F8FAFC">Advisory AI Boundary</text>
      <text x="48" y="43" font-family="Inter, sans-serif" font-size="11" font-weight="500" fill="#64748B">No direct payment access</text>
    </g>

    <!-- Audit Pill -->
    <g transform="translate(0, 70)">
      <rect width="540" height="50" rx="10" fill="#111827" stroke="#1E293B" stroke-width="1.5"/>
      <text x="20" y="30" font-family="Inter, sans-serif" font-size="13" font-weight="600" fill="#94A3B8">
        Core Principle: <tspan fill="#F8FAFC" font-weight="700">"The planner proposes. The policy gate authorizes."</tspan>
      </text>
    </g>
  </g>

  <!-- Right Side Visual: Permission Shield Boundary Artwork -->
  <g transform="translate(760, 110)" filter="url(#cardShadow)">
    <!-- Boundary Container Card -->
    <rect width="420" height="490" rx="16" fill="#0D1322" stroke="#1E293B" stroke-width="2"/>

    <!-- Perimeter Circuit Boundary -->
    <rect x="24" y="24" width="372" height="442" rx="10" fill="none" stroke="#2563EB" stroke-width="1" stroke-dasharray="6,4" stroke-opacity="0.6"/>

    <!-- Central Glowing Shield -->
    <g transform="translate(210, 160)" filter="url(#glowEffect)">
      <path d="M 0 -70 L 60 -40 L 60 20 C 60 65, 0 95, 0 95 C 0 95, -60 65, -60 20 L -60 -40 Z" fill="url(#shieldGrad)" stroke="#60A5FA" stroke-width="2.5"/>
      <!-- Padlock Icon inside Shield -->
      <path d="M -14 0 L 14 0 C 17 0, 19 2, 19 5 L 19 24 C 19 27, 17 29, 14 29 L -14 29 C -17 29, -19 27, -19 24 L -19 5 C -19 2, -17 0, -14 0 Z" fill="#F8FAFC"/>
      <path d="M -9 0 L -9 -9 C -9 -14, -5 -18, 0 -18 C 5 -18, 9 -14, 9 -9 L 9 0" fill="none" stroke="#F8FAFC" stroke-width="3" stroke-linecap="round"/>
      <circle cx="0" cy="14" r="3" fill="#1E293B"/>
    </g>

    <!-- Interactive Gate Output Card -->
    <g transform="translate(50, 310)">
      <rect width="320" height="120" rx="8" fill="#111827" stroke="#1E293B" stroke-width="1.5"/>
      
      <!-- Status Tag -->
      <rect x="16" y="16" width="90" height="24" rx="12" fill="#065F46"/>
      <text x="61" y="32" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" font-weight="700" fill="#34D399">MANDATE PASS</text>
      
      <text x="16" y="66" font-family="monospace" font-size="12" fill="#F8FAFC">
        &gt; Cap Check: ₹799 &lt; ₹2,500
      </text>
      <text x="16" y="86" font-family="monospace" font-size="12" fill="#34D399">
        &gt; Decision: ORDER_AUTHORIZED
      </text>
      <text x="16" y="106" font-family="monospace" font-size="11" fill="#64748B">
        &gt; Auth Key: rzp_ord_TU4CTaTOh...
      </text>
    </g>
  </g>

  <!-- Footer Razorpay / Hackathon Attribution -->
  <text x="100" y="630" font-family="Inter, sans-serif" font-size="13" font-weight="500" fill="#475569">
    Razorpay AI Buildathon 2026 • Production-Ready Agent Architecture
  </text>
</svg>
